<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared parent for every service in this repo: ONE place that decides the versions of
  Java, Spring Boot, Spring Cloud and (through their BOMs) every library they bring in.

  Why it exists: each service used to pick its own Spring Boot / Spring Cloud versions, so the
  same library ran at different versions in different services (Spring Framework 6.1.6 in the
  gateway vs 7.0.3 elsewhere, three different Spring Cloud trains). An upgrade now is a one-line
  change here, and every service moves together.

  How a service uses it:
    <parent>
      <groupId>com.example</groupId>
      <artifactId>shop-parent</artifactId>
      <version>1.0.0</version>
      <relativePath>../shop-parent/pom.xml</relativePath>
    </parent>
  and declares dependencies WITHOUT versions; the BOMs below supply them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot's parent: plugin defaults + the Spring Boot BOM (versions of ~400 libraries). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>shop-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>shop-parent</name>
  <description>Shared build configuration and dependency versions for all shop services</description>

  <properties>
    <java.version>21</java.version>
    <!-- Must be a train that supports the Spring Boot version above (see the Spring Cloud
         release notes); a mismatch fails at startup with a compatibility check error. -->
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <!-- Security overrides, in ONE place for every service. Spring Boot 4.1.1's BOM ships library
         versions with known CVEs that already have patch releases (found with Trivy, Oct 2026):
           Tomcat 11.0.24  -> 11.0.25  (3 critical: CVE-2026-65182, -65905, -68525)
           Jackson 2.21.5  -> 2.21.7   (high: CVE-2026-68497, -89407, -89425, -91776, -91777)
           Jackson 3.1.5   -> 3.1.7    (same CVEs, Jackson 3 line)
         Each override is a same-line patch bump. Delete it once Spring Boot's own BOM ships that
         version or newer (Renovate will flag it). -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <!-- Test coverage tool (not managed by Spring Boot's BOM; Renovate tracks this property). -->
    <jacoco.version>0.8.15</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM import: adds the versions of every Spring Cloud module (gateway, ...). -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- JaCoCo measures which lines and branches the tests actually execute.
           prepare-agent: attaches a Java agent to the test JVM that records executed code.
           report: turns that record into target/site/jacoco/ (HTML for people, CSV for CI).
           Bound to prepare-package so it runs in the Docker build's `mvn package`, right
           after the tests. It only REPORTS; no minimum is enforced yet (see README roadmap). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>prepare-package</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
